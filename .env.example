# Server-only env (Netlify Functions / local dev)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OCR_PREFER_AI_STATEMENTS=0
OCR_AUTO_PURGE_TEXT=0
OCR_AUTO_PURGE_SOURCE=0
OCR_EARLY_STOP_CONFIDENCE=0.85
MIN_PAGES_FOR_EARLY_STOP=2
OCR_STATEMENT_EARLY_STOP_MAX_PAGES=4
OCR_FALLBACK_MAX_PAGES=2
OCR_FALLBACK_PAGE_CONFIDENCE_THRESHOLD=0.70
OCR_FALLBACK_ORDER_STATEMENT=google,openai
OCR_FALLBACK_ORDER_RECEIPT=openai,google
OCR_FALLBACK_MONTHLY_CAP_FREE=10

# Server-enforced AI tool confirmation gate (HMAC signing secret, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOOL_CONFIRM_SECRET=

# Backend OCR keys (Netlify Functions — process-statement.ts)
ANTHROPIC_API_KEY=
GOOGLE_VISION_API_KEY=

# C1 financial-integrity containment (tag-categorize-committed.ts).
# Legacy pass that converts income rows from a hardcoded merchant list to expenses and NEGATES
# their amounts. DISABLED unless set to exactly 1. Leave unset: must NOT be enabled in staging
# or production without separate owner authorization. Kept commented so copying this file
# never enables it.
# TAG_LEGACY_INCOME_TO_EXPENSE_CONVERSION=

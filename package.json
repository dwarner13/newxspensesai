{
  "name": "xspenses",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:turbo": "npx --yes kill-port 8888 5174 5175 5176 5177 && npx --yes -p netlify-cli@23.9.0 netlify dev --port 8888 --target-port 5174 --command \"vite --port 5174 --host --strictPort\"",
    "dev:reset": "npx --yes kill-port 8888 5174 5175 5176 5177 && rm -rf .netlify/functions-serve",
    "dev:ui": "vite --port 5174",
    "nuke": "rm -rf node_modules package-lock.json && npm install",
    "dev": "vite --port 5174 --host",
    "build": "tsc && vite build",
    "build:ci": "pnpm -s build",
    "predeploy:ci": "pnpm -s build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "vite": "vite",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "verify:handoff": "rg \"Handoff from\" src/components/chat/UnifiedAssistantChat.tsx >/dev/null && rg \"greeting\" src/components/chat/UnifiedAssistantChat.tsx >/dev/null",
    "verify:no-autosend": "rg -n \"sendMessage\\(initialQuestion\\)\" src && exit 1 || exit 0",
    "parity": "tsx scripts/parityTest.ts --old=http://localhost:3000/old-chat --new=http://localhost:8888/.netlify/functions/chat",
    "parity:custom": "tsx scripts/parityTest.ts",
    "test:delegate": "tsx scripts/localDelegateCheck.ts",
    "sync:crystal": "ts-node scripts/sync-employee-prompt.ts crystal-analytics ./docs/CRYSTAL_2.0_SYSTEM_PROMPT.md",
    "sync:prime": "ts-node scripts/sync-employee-prompt.ts prime-boss ./docs/PRIME_CEO_PERSONA.md",
    "sync:byte": "ts-node scripts/sync-employee-prompt.ts byte-docs ./docs/BYTE_PERSONA.md",
    "sync:tag": "ts-node scripts/sync-employee-prompt.ts tag-categorizer ./docs/TAG_PERSONA.md",
    "sync:ledger": "ts-node scripts/sync-employee-prompt.ts ledger-tax ./docs/LEDGER_PERSONA.md",
    "sync:goalie": "ts-node scripts/sync-employee-prompt.ts goalie-agent ./docs/GOALIE_PERSONA.md",
    "sync:all": "npm run sync:crystal && npm run sync:prime && npm run sync:byte && npm run sync:tag && npm run sync:ledger && npm run sync:goalie && echo '✅ All employees synced!'",
    "memcap": "tsx scripts/memory_cap_scan.ts",
    "memcap:live": "tsx scripts/memory_cap_scan.ts --live",
    "byte:test": "tsx scripts/byte-test/run-byte-tests.ts",
    "byte:contract:bank": "npm run byte:test -- --contract --dir scripts/byte-test/fixtures/bank --fail-on-review",
    "byte:contract:credit": "npm run byte:test -- --contract --dir scripts/byte-test/fixtures/credit-card --fail-on-review",
    "byte:contract:scan": "npm run byte:test -- --contract --dir scripts/byte-test/fixtures/scanned --min-confidence 0.3",
    "byte:sanitize": "tsx scripts/byte-test/sanitize-output.ts",
    "tag:test": "tsx scripts/tag-test/run-tag-tests.ts",
    "tag:contract": "npm run tag:test -- --contract --dir scripts/tag-test/fixtures --fail-on-review",
    "tag:contract:bank": "npm run tag:test -- --contract --dir scripts/tag-test/fixtures/bank --fail-on-review",
    "tag:contract:credit": "npm run tag:test -- --contract --dir scripts/tag-test/fixtures/credit-card --fail-on-review",
    "tag:sanitize": "tsx scripts/tag-test/sanitize-output.ts",
    "tag:contract:safe": "npm run tag:contract && npm run tag:sanitize",
    "tag:contract:bank:safe": "npm run tag:contract:bank && npm run tag:sanitize",
    "tag:contract:credit:safe": "npm run tag:contract:credit && npm run tag:sanitize",
    "crystal:test": "tsx scripts/crystal-test/run-crystal-tests.ts",
    "crystal:contract": "npm run crystal:test -- --contract --dir scripts/crystal-test/fixtures --fail-on-review",
    "crystal:contract:from-tag": "npm run crystal:test -- --contract --dir scripts/crystal-test/fixtures/from-tag --fail-on-review",
    "crystal:contract:scanned": "npm run crystal:test -- --contract --dir scripts/crystal-test/fixtures/scanned --min-confidence 0.5",
    "finley:test": "tsx scripts/finley-test/run-finley-tests.ts",
    "finley:contract": "npm run finley:test -- --contract --dir scripts/finley-test/fixtures --fail-on-review",
    "finley:contract:from-tag-crystal": "npm run finley:test -- --contract --dir scripts/finley-test/fixtures/from-tag-crystal --fail-on-review",
    "payoff:test": "tsx scripts/payoff-test/run-payoff-tests.ts",
    "payoff:contract": "npm run payoff:test -- --contract",
    "pipe:test": "tsx scripts/pipeline-test/run-pipeline-tests.ts",
    "pipe:contract": "npm run pipe:test -- --contract --dir scripts/pipeline-test/fixtures --fail-on-review",
    "pipe:contract:bank": "npm run pipe:test -- --contract --dir scripts/pipeline-test/fixtures/bank --fail-on-review",
    "pipe:contract:credit": "npm run pipe:test -- --contract --dir scripts/pipeline-test/fixtures/credit-card --fail-on-review",
    "recurring:test": "tsx scripts/recurring-test/run-recurring-tests.ts",
    "help:fastlane:test": "tsx scripts/help-fast-lane-test.ts",
    "memory:gating:test": "tsx scripts/memory-gating-v2-smoke.ts",
    "sync:smoke:test": "tsx scripts/smart-import-sync-smoke.ts",
    "pdf:render:smoke": "tsx scripts/pdf-render-smoke.ts",
    "ocr:check": "tsx scripts/ocr-strength-check.ts",
    "ocr:check:sample": "npm run ocr:check -- scripts/byte-test/fixtures/bank/sample.pdf",
    "test:crystal": "tsx scripts/test-crystal.ts",
    "test:registry": "tsx scripts/test-employee-registry.ts",
    "test:finley": "tsx scripts/test-finley.ts",
    "test:finley-routing": "tsx scripts/test-finley-routing.ts",
    "netlify:dev": "npx --yes -p netlify-cli@23.9.0 netlify dev --port 8888",
    "worker:dev": "tsx watch worker/src/index.ts",
    "functions:build": "tsx scripts/build-functions.ts",
    "functions:dev": "cross-env FUNCTIONS_WATCH=true tsx watch scripts/build-functions.ts",
    "dev:netlify": "npx --yes -p netlify-cli@23.9.0 netlify dev --port 8888",
    "dev:netlify:warm": "concurrently --kill-others=false --raw \"npx --yes -p netlify-cli@23.9.0 netlify dev\" \"node scripts/prewarm-dev.mjs\"",
    "dev:netlify:alt": "npx --yes -p netlify-cli@23.9.0 netlify dev --port 8890 --target-port 5180 --command \"vite --port 5180 --host\"",
    "prewarm": "node scripts/prewarm-dev.mjs",
    "backfill:statement": "tsx scripts/backfill-statement-summary.ts",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.18.1",
    "axios": "^1.6.7",
    "chart.js": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.8",
    "jose": "^5.2.0",
    "jotai": "^2.6.4",
    "lucide-react": "^0.314.0",
    "openai": "^4.73.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.3",
    "recharts": "^2.12.7",
    "sharp": "^0.33.2",
    "stripe": "^14.19.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.1.1",
    "undici": "^6.12.1",
    "uuid": "^13.0.0",
    "vaul": "^0.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.4.4",
    "@netlify/functions": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.16",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.0.6",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.11",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.19.12",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "glob": "^10.5.0",
    "jsdom": "^24.0.0",
    "pdfkit": "^0.17.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^4.0.6"
  },
  "overrides": {
    "@typescript-eslint/parser": "^7.0.0"
  }
}
